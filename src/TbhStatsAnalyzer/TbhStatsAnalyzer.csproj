<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>TbhStatsAnalyzer</AssemblyName>
    <RootNamespace>TbhStatsAnalyzer</RootNamespace>
    <ApplicationIcon>Assets/app.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets/app.ico" />
    <Resource Include="Assets/app-icon.png" />
    <None Include="../../native/build/TbhObserver.dll" Link="TbhObserver.payload.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
